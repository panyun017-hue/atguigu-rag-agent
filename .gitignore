# =========================
# 1. 环境变量（绝密，绝对不要上传）
# =========================
.env

# =========================
# 2. 虚拟环境（非常大，且因电脑而异，不上传）
# =========================
.venv/
venv/
env/

# =========================
# 3. Python 缓存文件（自动生成的，不需要传）
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 4. Jupyter Notebook 缓存（自动生成）
# =========================
.ipynb_checkpoints/

# =========================
# 5. 系统的垃圾文件（Mac/Windows）
# =========================
.DS_Store
Thumbs.db
.idea/